PORT=4317
WANXIANG_WEB_ORIGIN=http://localhost:3000
WANXIANG_WORKSPACE_ROOT=../wanxiang-workspaces

# 可选：开发时指向已经构建的 DSH CLI。未设置时使用本项目依赖的稳定版。
# DSH_CLI_PATH=/absolute/path/to/deepseek-harness/apps/cli/lib/bin.js

# 修改后的 DSH Web 源码、监听端口和万象 Bundle。
DEEPSEEK_HARNESS_REPO=/Users/finewood/deepseek-harness
WANXIANG_DSH_WEB_PORT=3081
# WANXIANG_DSH_BUNDLE_PATCH=/absolute/path/to/wanxiang-dsh-bundle/cordis.patch.yml

# 可选：沿用指定的 DSH profile、凭证和 Session 存储。
# DSH_HOME=/absolute/path/to/.dsh

# 遇到额度/限流时默认持续等待并自动重试。
WANXIANG_DSH_WAIT_ON_RATE_LIMIT=true
WANXIANG_DSH_RETRY_SECONDS=60
WANXIANG_DSH_TIMEOUT_MS=900000
